# ─────────────────────────────────────────────────────────────────
# .env.example — Required environment variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# You only need the key(s) for the provider(s) you plan to use.
# At minimum, set ONE provider key to run benchmarks.
# ─────────────────────────────────────────────────────────────────

# Google AI Studio (free tier available)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Groq (free tier available)
GROQ_API_KEY=your-groq-api-key-here

# LangSmith tracing (optional — for debugging and observability)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-memory-benchmark
